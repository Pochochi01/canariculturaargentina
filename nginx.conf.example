# ─────────────────────────────────────────────────────────────────────────────
# Nginx — Canaricultura
# Copiar a /etc/nginx/sites-available/canaricultura
# Luego: ln -s /etc/nginx/sites-available/canaricultura /etc/nginx/sites-enabled/
#         nginx -t && systemctl reload nginx
# ─────────────────────────────────────────────────────────────────────────────

server {
    listen 80;
    server_name TU_IP_O_DOMINIO;          # ← reemplazar

    # Frontend: archivos estáticos compilados
    root /var/www/canaricultura/frontend/dist;
    index index.html;

    # SPA routing: cualquier ruta que no sea un archivo real → index.html
    location / {
        try_files $uri $uri/ /index.html;
    }

    # API: proxy al backend Node.js
    location /api/ {
        proxy_pass         http://127.0.0.1:5000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
    }

    # Archivos subidos (uploads del backend)
    location /uploads/ {
        proxy_pass http://127.0.0.1:5000;
    }

    location /revistas/ {
        proxy_pass http://127.0.0.1:5000;
    }
}

# ─── Con HTTPS (Let's Encrypt / Certbot) ─────────────────────────────────────
# Después de correr: certbot --nginx -d tu-dominio.com
# Certbot modifica este archivo automáticamente para agregar el bloque SSL.
