# ── Desarrollo local ─────────────────────────────────────────────────────────
PORT=5000
MONGODB_URI=mongodb://localhost:27017/canaricultura
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=2h
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ── Producción (VPS) — copiar como .env y completar ──────────────────────────
# PORT=5000
# MONGODB_URI=mongodb://localhost:27017/canaricultura
# JWT_SECRET=clave_larga_y_aleatoria_minimo_32_caracteres
# JWT_EXPIRES_IN=2h
# NODE_ENV=production
# FRONTEND_URL=http://TU_IP_O_DOMINIO
#
# Si querés permitir acceso desde varios orígenes separar con coma:
# FRONTEND_URL=https://tu-dominio.com,http://TU_IP:5173
